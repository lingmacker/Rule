
# --- Typography ---
font-family = "Maple Mono NF CN"
font-size = 12
font-thicken = false
adjust-cell-height = 6

# --- Theme and Colors ---
theme = Atom one Dark

# --- Window and Appearance ---
background-opacity = 0.87
macos-titlebar-style = transparent
macos-titlebar-proxy-icon = hidden
title = " "
background-blur-radius = 20
window-padding-x = 14
window-padding-y = 10
window-save-state = never
window-inherit-working-directory = false
working-directory = home
window-width = 120
window-height = 26
window-theme = auto
window-padding-balance = true

# --- Cursor ---
cursor-style = block
cursor-style-blink = false
cursor-opacity = 0.7

# --- Mouse ---
mouse-hide-while-typing = true
copy-on-select = clipboard
mouse-shift-capture = true
selection-foreground = cell-background
selection-background = cell-foreground

# --- Quick Terminal (Quake-style dropdown) ---
quick-terminal-position = center
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15
quick-terminal-size = 80%,80%

# Quick terminal global hotkey
# keybind = global:ctrl+grave_accent=toggle_quick_terminal
keybind = global:f12=toggle_quick_terminal

# --- Close behavior ---
confirm-close-surface = false

# --- Security ---
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

# --- Shell Integration ---
shell-integration = detect
shell-integration-features = sudo,no-title,ssh-env,ssh-terminfo,path,no-cursor

# --- Keybindings ---
# Tabs
keybind = cmd+t=new_tab
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab
keybind = cmd+w=close_surface

# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom

# Font size
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Splits management
keybind = cmd+shift+e=equalize_splits
keybind = cmd+shift+enter=toggle_split_zoom

# Reload config
keybind = cmd+shift+comma=reload_config

# global new window
keybind = global:shift+f12=new_window

# 移除默认的 attention 行为（防止 Dock 图标跳动）
bell-features = no-attention,title
macos-option-as-alt = left

# --- Performance ---
scrollback-limit = 25000000